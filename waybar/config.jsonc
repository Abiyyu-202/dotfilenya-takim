{
    "reload_style_on_change": true,
    "height": 32,
    "spacing": 3,
    "margin-top": 3,
    "margin-left": 6,
    "margin-right": 6,
    "fixed-center": true,

    "modules-left": [
        "group/info",
        "niri/workspaces",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "group/center"
    ],

    "modules-right": [
        "tray",
        "group/status",
        "custom/power"
    ],

    // ── Unified Info Pill (Clock + Weather) ─────────────
    "group/info": {
        "orientation": "horizontal",
        "modules": [
            "group/clock",
            "custom/weather"
        ]
    },

    // ── Unified Center Pill (MPRIS + Window Title) ──────
    "group/center": {
        "orientation": "horizontal",
        "spacing": 0,
        "modules": [
            "mpris",
            "niri/window",
            "hyprland/window"
        ]
    },

    // ── Drawer: Clock (time → date on hover) ───────────
    "group/clock": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "drawer-child",
            "transition-left-to-right": true
        },
        "modules": [
            "clock",
            "custom/date"
        ]
    },

    // ── Outer status pill ───────────────────────────────
    "group/status": {
        "orientation": "horizontal",
        "modules": [
            "group/network",
            "group/audio",
            "group/brightness",
            "group/battery"
        ]
    },

    // ── Drawer: Network (smart icon → SSID on hover) ────
    "group/network": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "drawer-child",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/network-smart",
            "custom/network-ssid"
        ]
    },

    // ── Drawer: Audio (smart icon → slider on hover) ───
    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "drawer-child",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/pulseaudio-smart",
            "pulseaudio/slider"
        ]
    },

    // ── Drawer: Brightness (smart icon → slider on hover)
    "group/brightness": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "drawer-child",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/backlight-smart",
            "backlight/slider"
        ]
    },

    // ── Drawer: Battery (icon → detail on hover) ───────
    "group/battery": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "drawer-child",
            "transition-left-to-right": true
        },
        "modules": [
            "battery",
            "custom/battery-detail"
        ]
    },

    // ── Workspaces ──────────────────────────────────────
    "niri/workspaces": {
        "format": "{icon}",
        "sort-by-name": true,
        "display-condition": "keep-named",
        "format-icons": {
            "focused": "",
            "active": "",
            "default": "",
            "empty": ""
        }
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": [1, 2, 3]
        },
        "format-icons": {
            "active": "",
            "empty": "",
            "default": ""
        }
    },

    // ── Niri Window Title ───────────────────────────────
    "niri/window": {
        "format": "{}",
        "separate-outputs": true,
        "max-length": 50,
        "icon": true,
        "icon-size": 14,
        "show-empty": true,
        "rewrite": {
            "^$": "󰇄  Desktop"
        }
    },

    // ── Hyprland Window Title ───────────────────────────
    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true,
        "max-length": 50,
        "fallback": "󰇄  Desktop",
        "icon": true,
        "icon-size": 14
    },

    // ── Clock (time only) ───────────────────────────────
    "clock": {
        "interval": 1,
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // ── Date (drawer child) ─────────────────────────────
    "custom/date": {
        "exec": "~/.config/waybar/scripts/date-display.sh",
        "return-type": "json",
        "interval": 60
    },

    // ── Network smart (auto-expand on connect/disconnect)
    "custom/network-smart": {
        "exec": "~/.config/waybar/scripts/network-smart.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "~/.config/waybar/scripts/toggle-network-manager.sh",
        "on-click-right": "~/.config/waybar/scripts/toggle-hotspot.sh"
    },

    "custom/network-ssid": {
        "exec": "~/.config/waybar/scripts/network-ssid.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/toggle-network-manager.sh",
        "on-click-right": "~/.config/waybar/scripts/toggle-hotspot.sh"
    },

    // ── Audio smart (auto-expand on volume change) ──────
    "custom/pulseaudio-smart": {
        "exec": "~/.config/waybar/scripts/pulseaudio-smart.sh",
        "return-type": "json",
        "interval": 1,
        "on-click": "pavucontrol"
    },

    // ── Brightness smart (auto-expand on change) ────────
    "custom/backlight-smart": {
        "exec": "~/.config/waybar/scripts/backlight-smart.sh",
        "return-type": "json",
        "interval": 1
    },

    // ── (kept for drawer hover child) ───────────────────
    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "{icon} ",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "tooltip-format": "󰕾  {volume}%\n  {desc}",
        "on-click": "pavucontrol"
    },

    // ── Slider children (shown on hover via drawer) ────
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "backlight/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    // ── Battery (icon only) ─────────────────────────────
    "battery": {
        "interval": 5,
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰚥",
        "format-full": "󰁹",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "  {capacity}%\nKlik: Menu Mode Daya\nKlik Kanan / Scroll: Ganti Profil",
        "tooltip-format-charging": "󰂄  Charging {capacity}%\nKlik: Menu Mode Daya\nKlik Kanan / Scroll: Ganti Profil",
        "tooltip-format-full": "󰁹  Fully charged\nKlik: Menu Mode Daya\nKlik Kanan / Scroll: Ganti Profil",
        "on-click": "~/.config/waybar/scripts/power-profiles-menu.sh",
        "on-click-right": "~/.config/waybar/scripts/cycle-power-profile.sh",
        "on-scroll-up": "powerprofilesctl set performance && notify-send -u low -i preferences-system-power 'Mode Daya' 'Mode Performance'",
        "on-scroll-down": "powerprofilesctl set power-saver && notify-send -u low -i preferences-system-power 'Mode Daya' 'Mode Power Saver'"
    },

    "custom/battery-detail": {
        "exec": "~/.config/waybar/scripts/battery-detail.sh",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.config/waybar/scripts/power-profiles-menu.sh",
        "on-click-right": "~/.config/waybar/scripts/cycle-power-profile.sh"
    },

    // ── Tray ────────────────────────────────────────────
    "tray": {
        "spacing": 12
    },

    // ── Power ───────────────────────────────────────────
    "custom/power": {
        "format": "",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power-menu.xml",
        "menu-actions": {
            "shutdown": "shutdown now",
            "reboot": "shutdown -r now",
            "suspend": "systemctl suspend",
            "logout": "hyprctl dispatch 'hl.dsp.exit()' || pkill -x Hyprland",
            "lock": "hyprlock"
        }
    },

    // ── Weather ─────────────────────────────────────────
    "custom/weather": {
        "exec": "~/.config/waybar/scripts/weather.sh",
        "return-type": "json",
        "interval": 1800,
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/set-weather-city.sh",
        "format": "{}"
    },

    // ── Media Player (MPRIS) ────────────────────────────
    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "{status_icon}  <i>{dynamic}</i>",
        "format-stopped": "",
        "player-icons": {
            "default": "",
            "spotify": "",
            "firefox": "",
            "chromium": "",
            "mpv": ""
        },
        "status-icons": {
            "paused": ""
        },
        "max-length": 32,
        "tooltip": true,
        "tooltip-format": "{player_icon} {player} ({status})\n󰎆 {title}\n󰠃 {artist}\n󰀥 {album}\n󱑂 [{position}/{length}]\n\n🖱️ Klik Kiri: Play/Pause\n🖱️ Klik Kanan: Next Track\n🖱️ Klik Tengah: Prev Track\n🔄 Scroll: Seek Lagu (±5s)",
        "tooltip-format-paused": "{status_icon} {player} (Paused)\n󰎆 {title}\n󰠃 {artist}\n󰀥 {album}\n󱑂 [{position}/{length}]\n\n🖱️ Klik Kiri: Resume\n🖱️ Klik Kanan: Next Track\n🖱️ Klik Tengah: Prev Track\n🔄 Scroll: Seek Lagu (±5s)",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl position 5+",
        "on-scroll-down": "playerctl position 5-"
    }
}
